{
  "name": "generador-ride",
  "version": "0.1.0",
  "description": "Generador de RIDE (Reportes Integrales de Documentos Electrónicos) para comprobantes electrónicos del SRI Ecuador.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "bun@1.4.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.4.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:worker": "bun run build && vitest --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "test:package": "bun scripts/test-package.mjs",
    "benchmark": "bun scripts/benchmark.mjs",
    "check:bundle": "bun scripts/check-worker-bundle.mjs",
    "verify": "bun run typecheck && bun run test && bun run test:worker && bun run build && bun run test:package && bun run check:bundle"
  },
  "dependencies": {
    "pdfkit": "0.19.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bun": "1.4.0",
    "pdfjs-dist": "^4.10.38",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
